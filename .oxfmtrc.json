{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "useTabs": false,
  "tabWidth": 2,
  "bracketSpacing": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "printWidth": 80,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/public/**",
    "!**/public/sw.js",
    "**/node_modules/**",
    "**/.cache/**",
    "**/.next/**",
    "**/.lighthouseci/**",
    "pnpm-lock.yaml",
    "packages/markdown-rs/vendor/**",
    "**/*.css",
    "**/*.scss",
    "**/*.html",
    "infra/otel/grafana/dashboards/**"
  ],
  "overrides": [
    {
      "files": [
        "apps/blog/posts/2026/10/how-bundlers-remember-imports*.md",
        "apps/research/research/feconf-2026-vendor-sdk.md",
        "apps/blog/posts/2026/10/cwv-to-tempo-and-mimir*.md",
        "apps/research/research/cwv-basics-and-grafana.md"
      ],
      "options": {"embeddedLanguageFormatting": "off"}
    }
  ]
}
