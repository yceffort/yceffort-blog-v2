# infra/otel/.env 로 복사해 쓴다(.env 는 커밋하지 않는다).
OTEL_DOMAIN=otel.yceffort.kr
ALLOWED_ORIGIN=https://yceffort.kr
GRAFANA_ADMIN_PASSWORD=change-me
# 보존 기간. Tempo 기본값은 14일, Mimir 의 0 은 지우지 않는다는 뜻이다.
TEMPO_RETENTION=8760h
# Tempo 에서 한 번에 조회할 수 있는 범위(trace 검색과 TraceQL metrics). 기본값은 검색 168h, metrics 24h 다.
TEMPO_QUERY_RANGE=8760h
MIMIR_RETENTION=0
