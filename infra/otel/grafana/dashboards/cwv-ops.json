{
  "uid": "cwv-ops",
  "title": "CWV 운영 (Mimir)",
  "tags": [
    "cwv"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "화면",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(cwv_lcp_milliseconds_count, page_route)",
          "refId": "route"
        },
        "definition": "label_values(cwv_lcp_milliseconds_count, page_route)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "지금 얼마나 느린가 (선택 구간 전체의 p75)",
