{
  "uid": "cwv-why",
  "title": "CWV 원인 분석 (Tempo)",
  "tags": [
    "cwv"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "화면",
        "type": "custom",
        "query": ".*,home,post,tag,series,other",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          },
          {
            "text": "home",
            "value": "home",
            "selected": false
          },
          {
            "text": "post",
            "value": "post",
            "selected": false
          },
          {
            "text": "tag",
            "value": "tag",
            "selected": false
          },
          {
            "text": "series",
            "value": "series",
            "selected": false
          },
          {
            "text": "other",
            "value": "other",
            "selected": false
          }
        ]
      }
    ]
  },
