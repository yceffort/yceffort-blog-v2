    {
      "type": "bargauge",
      "title": "글별 LCP p75 (느린 10개)",
      "description": "Tempo 의 분위수는 2 의 거듭제곱 버킷 사이를 보간한 근사값이다. 표본이 적은 글은 값이 크게 흔들린다.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"yceffort-blog\" && span.page.route=~\"$route\" && span.page.route=\"post\" && name=\"cwv.lcp\"} | quantile_over_time(duration, .75) by (span.page.path) | topk(10)",
          "metricsQueryType": "instant",
          "step": "5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2.5
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "valueMode": "color"
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*span.page.path=\"([^\"]*)\".*",
            "renamePattern": "$1"
          }
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 10,
